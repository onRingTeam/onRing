# 프론트(Expo) 환경변수 예시. 이 파일을 복사해 `.env.local` 로 만들고 실제 값 채우기.
# EXPO_PUBLIC_ 접두사 변수만 앱 번들에 노출됨. Metro 재시작(-c) 시 반영.

# 백엔드 주소. 안드로이드 에뮬레이터는 호스트PC = 10.0.2.2. (원격 쓰려면 이 줄 삭제)
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8080
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080/ws

# Supabase (구글 로그인). Publishable(anon) key만 — service_role 절대 금지.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
