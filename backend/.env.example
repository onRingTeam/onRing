# 백엔드 환경변수 예시. 이 파일을 복사해 `.env` 로 만들고 실제 값 채우기.
# application.yml 이 backend/.env 를 환경변수처럼 로드한다.

# DB 계정 (원격 MySQL, cloudflared 터널 127.0.0.1:13306 경유)
DB_USERNAME=xxx
DB_PASSWORD=xxx

# Supabase (구글 로그인 토큰 검증). anon(publishable) key — service_role 아님.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 운영 전용(로컬은 기본값 사용). 운영 배포 시 반드시 강한 값으로 주입.
# JWT_SECRET=change-me-in-prod
